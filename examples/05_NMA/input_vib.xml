<simulation mode='static' verbosity='high'>
  <output prefix='simulation'>
    <properties stride='10' filename='out'>  [ step, potential ] </properties>
  </output>
  <total_steps> 5000 </total_steps>
  <prng>
    <seed> 32342 </seed>
  </prng>
  <ffsocket mode='unix' name="driver">
    <address> driver </address>
    <port> 31415 </port>
    <latency> 0.0001 </latency>
    <timeout> 4000 </timeout>
  </ffsocket>
  <system>
    <initialize nbeads='1'>
      <file mode='xyz' units='angstrom'> trans.opt </file>
      <cell mode="abc"> [ 1000.0, 1000.0, 1000.0 ] </cell>
    </initialize>
    <forces>
      <force forcefield='driver'> </force>
    </forces>
    <motion mode='vibrations'>
      <vibrations mode='fd'>
        <pos_shift> 0.001 </pos_shift>
        <energy_shift> 0.001 </energy_shift>
        <prefix> nma </prefix>
        <asr> poly </asr>
      </vibrations>
    </motion>
  </system>
</simulation>
