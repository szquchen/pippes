    </initialize>
    <forces>
      <force forcefield='driver'/>
    </forces>
    <ensemble>
      <temperature units='kelvin'>298.15</temperature>
      <pressure units='atmosphere'> 1.0 </pressure>
    </ensemble>
    <motion mode='dynamics'>
      <fixcom> True </fixcom>
      <dynamics mode='npt'>
        <barostat mode='isotropic'>
