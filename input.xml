<simulation verbosity="low">
    <output prefix="simulation">
    <properties stride='1' filename='out'>  [ step, time{picosecond}, conserved{kilocal/mol}, temperature{kelvin}, potential, pressure_cv{megapascal}, ensemble_pressure{atmosphere}, pressure_md{atmosphere}, volume, density{g/cm3} ] </properties>
